<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="zh-CN" Title="桌屿" Width="1032" Height="686"
        MinWidth="790" MinHeight="475" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        Background="#F6F5EF" Foreground="#19342D">
    <Window.Resources>
        <SolidColorBrush x:Key="Paper" Color="#F6F5EF"/>
        <SolidColorBrush x:Key="White" Color="#FFFEFA"/>
        <SolidColorBrush x:Key="Ink" Color="#19342D"/>
        <SolidColorBrush x:Key="Muted" Color="#53665D"/>
        <SolidColorBrush x:Key="Line" Color="#D9E1D8"/>
        <SolidColorBrush x:Key="Rail" Color="#19342D"/>
        <SolidColorBrush x:Key="RailText" Color="#E4EFE8"/>
        <SolidColorBrush x:Key="RailMuted" Color="#ACC3B6"/>
        <SolidColorBrush x:Key="Accent" Color="#68C4A6"/>
        <SolidColorBrush x:Key="AccentInk" Color="#0B372B"/>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Background" Value="{StaticResource White}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#247F67"/>
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.44"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
            <Setter Property="BorderBrush" Value="#59B797"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#82D4B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RailAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Foreground" Value="{StaticResource RailText}"/>
            <Setter Property="Background" Value="#254038"/>
            <Setter Property="BorderBrush" Value="#476155"/>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource RailText}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavSurface" MinHeight="40" CornerRadius="5" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <Border x:Name="IndexTab" Width="3" Height="18" Background="{StaticResource Accent}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="0,2,2,0"
                                        Visibility="Collapsed"/>
                                <ContentPresenter Margin="12,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#25443A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#34564B"/>
                                <Setter TargetName="IndexTab" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FileSurface" Background="Transparent" MinHeight="46"
                                BorderThickness="0,0,0,1" BorderBrush="#E5E9E1">
                            <Grid>
                                <Border x:Name="FileFocus" BorderThickness="1" IsHitTestVisible="False"/>
                                <ContentPresenter Margin="16,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FileSurface" Property="Background" Value="#F0F6F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FileSurface" Property="Background" Value="#DDEFE5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FileFocus" Property="BorderBrush" Value="#39846B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="209"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Rail}">
            <Grid Margin="16,29,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,30">
                    <Grid Width="39" Height="39" Margin="0,0,12,0" IsHitTestVisible="False">
                        <Border Background="{StaticResource Accent}" CornerRadius="8"/>
                        <Path Stroke="{StaticResource AccentInk}" StrokeThickness="1.7" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 9,29 L 9,16 L 15,16 L 18,10 L 27,10 L 30,16 L 30,29 Z M 14,23 L 25,23 M 14,19 L 25,19"/>
                    </Grid>
                    <TextBlock Text="桌屿" Foreground="{StaticResource RailText}" FontSize="24" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="分组" Foreground="{StaticResource RailMuted}" FontSize="12"
                           Margin="11,0,0,8"/>

                <ListBox x:Name="NavList" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0"
                         AutomationProperties.Name="分组" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" VerticalAlignment="Center" FontSize="15"
                                           FontFamily="Segoe UI Symbol, Microsoft YaHei UI"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center"
                                           FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource RailMuted}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="3" Margin="2,12,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Background="#476155" />
                    <Button x:Name="DesktopButton" Grid.Row="1" Content="用桌面" Style="{StaticResource RailAction}"
                            Margin="0,13,3,0" Padding="4,0" ToolTip="整理当前 Windows 桌面"/>
                    <Button x:Name="ChooseRootButton" Grid.Row="1" Grid.Column="1" Content="换文件夹…"
                            Style="{StaticResource RailAction}" Margin="3,13,0,0" Padding="4,0"
                            ToolTip="选择要整理的文件夹"/>
                    <Button x:Name="ZonesButton" Grid.Row="2" Grid.ColumnSpan="2" Content="桌面分区设置"
                            Style="{StaticResource RailAction}" Margin="0,6,0,0" ToolTip="打开桌面分区与自动归类设置"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,28,28,13">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="SectionTitle" Text="全部文件" FontSize="32" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                <Grid Margin="1,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Stroke="{StaticResource Muted}" StrokeThickness="1.2" StrokeLineJoin="Round"
                          Data="M 1,3 L 6,3 L 8,5 L 14,5 L 14,13 L 1,13 Z"
                          Width="15" Height="15" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="RootLabel" Grid.Column="1" Text="请选择整理位置" Foreground="{StaticResource Muted}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,23,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" AutomationProperties.Name="搜索文件名"
                         VerticalContentAlignment="Center" Padding="34,0,9,0" MinHeight="35"
                         Background="{StaticResource White}" Foreground="{StaticResource Ink}"
                         BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="SearchSurface" Background="{TemplateBinding Background}" CornerRadius="5"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Path Data="M 10,5.8 A 4.2,4.2 0 1 1 1.6,5.8 A 4.2,4.2 0 1 1 10,5.8 M 9,9 L 13,13"
                                          Stroke="{StaticResource Muted}" StrokeThickness="1.3" StrokeEndLineCap="Round"
                                          Width="15" Height="15" Margin="11,0,0,0" HorizontalAlignment="Left"
                                          VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SearchHint" Text="搜索文件名" Foreground="{StaticResource Muted}"
                                               Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                               Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="SearchHint" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="SearchSurface" Property="BorderBrush" Value="#247F67"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource Action}"
                            ToolTip="重新读取当前整理位置" Margin="0,0,6,0"/>
                    <Button x:Name="PinButton" Content="浮窗" Style="{StaticResource Action}"
                            ToolTip="在桌面浮窗中显示当前分组" Margin="0,0,6,0"/>
                    <Button x:Name="OpenArchiveButton" Content="打开归档" Style="{StaticResource Action}"
                            ToolTip="在资源管理器中打开归档文件夹" Margin="0,0,6,0"/>
                    <Button x:Name="UndoButton" Content="撤销归档" Style="{StaticResource Action}" Margin="0,0,6,0"/>
                    <Button x:Name="ArchiveButton" Content="归档…" Style="{StaticResource PrimaryAction}"
                            ToolTip="预览所选文件的归档位置"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource White}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#ECF0E8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="5,5,0,0" Padding="16,0,24,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.3*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文件名" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="类型" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="详细信息" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="FilesList" Grid.Row="1" SelectionMode="Extended" BorderThickness="0" Padding="0"
                             Background="Transparent" AutomationProperties.Name="文件列表"
                             ItemContainerStyle="{StaticResource FileItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.3*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="37"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                CornerRadius="5" Background="#EEF3EC">
                                            <Grid>
                                                <Image Source="{Binding Icon}" Width="17" Height="17" Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Path x:Name="FallbackIcon" Visibility="Collapsed" Width="14" Height="17"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Stroke="#597267" StrokeThickness="1.1" StrokeLineJoin="Round"
                                                      Data="M 2,1 L 8,1 L 12,5 L 12,15 L 2,15 Z M 8,1 L 8,5 L 12,5 M 4.5,8 L 9.5,8 M 4.5,11 L 9.5,11"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{StaticResource Muted}"
                                               Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyLabel" Grid.Row="1" Text="这个分组暂无文件"
                               Visibility="Collapsed" IsHitTestVisible="False" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}" FontSize="15" TextAlignment="Center"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"/>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,11,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel" Foreground="{StaticResource Muted}" FontSize="12"
                           MinHeight="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock Grid.Column="1" Text="双击打开 · 支持多选" Foreground="{StaticResource Muted}"
                           FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
