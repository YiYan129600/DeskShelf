+use super::*;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) struct MirrorGeometry {
+    expanded: RECT,
+    rolled: bool,
+    row_bottom: bool,
+}
+
+impl FenceWindow {
+    /// Creates a hidden projection of an existing fence on another physical display.
+    /// `bounds` is its expanded rectangle in virtual-screen pixels. Both HWNDs are
+    /// registered independently with the desktop anchor and use their own DPI and backdrop.
+    pub fn create_mirror(ctx: &FenceContext, source: &Self, bounds: RECT) -> Result<Self> {
+        let (title, inbox, grid, items) = {
+            let guard = source.view.borrow();
+            let Some(v) = guard.as_ref() else {
+                return Err(windows_core::Error::new(
+                    windows_core::HRESULT(0x80004005u32 as i32),
+                    "source fence view unavailable",
+                ));
+            };
+            (
+                v.title.clone(),
+                v.is_inbox,
+                v.grid(),
+                mirror_items(&v.items),
+            )
+        };
+        let mirror = Self::create_with_queue(
+            ctx,
+            source.id,
+            &title,
+            inbox,
+            false,
+            false,
+            false,
+            grid.icon_size,
+            grid.label_lines,
+            false,
+            bounds,
+            bounds.bottom - bounds.top,
+            items,
+            ctx.queue.for_mirror(),
+        )?;
+        mirror.mirror_geometry.set(Some(MirrorGeometry {
+            expanded: bounds,
+            rolled: false,
+            row_bottom: false,
+        }));
+        mirror.sync_mirror_from(source);
+        Ok(mirror)
+    }
+
+    /// Refreshes the projection from the displayed content of its source window. This
+    /// leaves the mirror's own pointer, selection and scroll offset in place for the
+    /// same tab, with items remapped by ID when the source list changes.
+    pub fn sync_mirror_from(&self, source: &Self) {
+        let Some(geometry) = self.mirror_geometry.get() else {
+            return;
+        };
+        if self.id != source.id || self.hwnd() == source.hwnd() || self.mirror_geometry_busy() {
+            return;
+        }
+        let Ok(guard) = source.view.try_borrow() else {
+            return;
+        };
+        let Some(v) = guard.as_ref() else {
+            return;
+        };
+        let (
+            theme_changed,
+            backdrop_changed,
+            active_changed,
+            tabs_changed,
+            rail_changed,
+            reveal_changed,
+            note_changed,
+            script_changed,
+        ) = {
+            let mirror = self.view.borrow();
+            let Some(m) = mirror.as_ref() else {
+                return;
+            };
+            if m.tab_drag.as_ref().is_some_and(|drag| drag.moved) {
+                return;
+            }
+            (
+                m.theme != v.theme || m.shadow.style() != v.shadow.style(),
+                !Rc::ptr_eq(&m.backdrops, &v.backdrops),
+                m.active != v.active,
+                m.tabs != v.tabs,
+                (m.rail_dip > 0.0) != v.tabs_on_rail(),
+                m.reveal_on_hover != v.reveal_on_hover,
+                m.note.as_deref() != shown_note(v),
+                m.script != v.script,
+            )
+        };
+        if theme_changed {
+            self.set_theme(v.theme, v.backdrops.clone(), v.shadow.style(), v.style);
+        } else {
+            self.set_style(v.style);
+            if backdrop_changed {
+                self.set_backdrops(v.backdrops.clone());
+            }
+        }
+        self.set_appearance(v.backdrop_override, v.opacity);
+        self.set_title_on_hover(v.title_on_hover_override);
+        self.set_transparent_on_hover(v.transparent_on_hover);
+        if reveal_changed {
+            self.set_reveal_on_hover(v.reveal_on_hover);
+        }
+        self.set_title(&v.title);
+        self.set_desktop_mark(v.desktop_tip.clone());
+        self.set_locked(v.locked);
+        self.set_expand_upward(v.expand_upward);
+        self.set_portal_deco(
+            v.is_portal,
+            v.deco.folder_icon,
+            v.deco.search_glyph,
+            v.deco.up_button,
+            v.navigate_folders,
+            v.portal_missing,
+            v.portal_folder.clone(),
+        );
+        if tabs_changed || active_changed {
+            self.set_tabs(v.tabs.clone(), v.active);
+        } else if rail_changed {
+            self.sync_tab_bar();
+        }
+        self.set_sort_indicator(v.sort, v.sort_reverse);
+        self.set_group_by_date(v.group_by_date);
+        self.set_columns_visible(v.columns_visible);
+        self.set_column_widths(v.column_widths);
+        self.set_is_inbox(v.is_inbox);
+        self.set_status_view(v.empty_override, v.empty_action, v.title_count.clone());
+        self.set_count_tip(v.count_tip.clone());
+        self.set_filtered(v.filter_active);
+        self.set_filter_tag(v.filter_tag.clone());
+        self.set_refuses_drops(v.refuses_drops);
+        self.set_text_size(v.text_size);
+        if note_changed {
+            self.set_note(shown_note(v).map(str::to_owned));
+        }
+        self.set_clock(v.clock);
+        if script_changed {
+            self.set_script(v.script.clone());
+        }
+        let grid = GridSpec {
+            layout: v.layout,
+            ..v.grid()
+        };
+        if active_changed || !self.shows_items(&v.items) {
+            if active_changed {
+                self.set_incoming_tab_view(grid);
+            }
+            self.set_items(mirror_items(&v.items));
+        }
+        self.set_grid(grid);
+        self.set_cut_items(&v.cut);
+        let rolled = v.roll_target() || v.peeking;
+        let row_bottom = if v.peeking {
+            geometry.row_bottom
+        } else {
+            v.row_bottom
+        };
+        drop(guard);
+
+        let next = MirrorGeometry {
+            rolled,
+            row_bottom,
+            ..geometry
+        };
+        if next != geometry {
+            self.apply_mirror_geometry(next);
+        } else if rolled && (theme_changed || tabs_changed || rail_changed) {
+            self.settle_rolled_size();
+        }
+    }
+
+    /// Applies the expanded rectangle selected by the display layout once the user
+    /// releases the window. At equal bounds, corrects only settled physical drift.
+    pub fn sync_mirror_bounds(&self, bounds: RECT) {
+        let Some(geometry) = self.mirror_geometry.get() else {
+            return;
+        };
+        if self.mirror_geometry_busy() {
+            return;
+        }
+        if geometry.expanded != bounds || self.matches_mirror_geometry(geometry) == Some(false) {
+            self.apply_mirror_geometry(MirrorGeometry {
+                expanded: bounds,
+                ..geometry
+            });
+        }
+    }
+
+    /// Whether the window is being positioned by the user or has a mirror placement
+    /// waiting to be committed by the app.
+    pub fn mirror_geometry_busy(&self) -> bool {
+        self.view.try_borrow().map_or(true, |view| {
+            view.as_ref().is_some_and(|v| {
+                v.queue.mirror_geometry_busy()
+                    || v.remote_drag.is_some()
+                    || v.behavior.size_move.borrow().as_ref().is_some_and(|gesture| {
+                        gesture.hwnd == v.hwnd || gesture.group.contains(&v.hwnd)
+                    })
+            })
+        })
+    }
+
+    /// Releases the editing guard after the app has handled the final rectangle.
+    pub fn finish_mirror_geometry_edit(&self) {
+        if let Some(v) = self.view.borrow().as_ref() {
+            v.queue.set_mirror_geometry_busy(false);
+        }
+    }
+
+    /// Compares the displayed file metadata, including the full names and icon keys.
+    pub fn displays_same_files_as(&self, source: &Self) -> bool {
+        source
+            .view
+            .try_borrow()
+            .ok()
+            .and_then(|view| view.as_ref().map(|v| self.shows_items(&v.items)))
+            .unwrap_or(false)
+    }
+
+    fn apply_mirror_geometry(&self, geometry: MirrorGeometry) {
+        self.mirror_geometry.set(Some(geometry));
+        if self.matches_mirror_geometry(geometry) == Some(true) {
+            return;
+        }
+        self.set_row_at_bottom(geometry.row_bottom);
+        let bounds = geometry.expanded;
+        self.restore_geometry(bounds, geometry.rolled, bounds.bottom - bounds.top);
+    }
+
+    fn matches_mirror_geometry(&self, geometry: MirrorGeometry) -> Option<bool> {
+        let view = self.view.try_borrow().ok()?;
+        let v = view.as_ref()?;
+        // A hover peek or roll animation owns the native rectangle temporarily.
+        if v.peeking || v.height_animating() || v.glide.is_some() || v.pending_place.is_some() {
+            return None;
+        }
+        let mut expected = geometry.expanded;
+        if v.rolled_up != geometry.rolled
+            || v.row_bottom != geometry.row_bottom
+            || v.expanded_w_px != expected.right - expected.left
+            || v.expanded_h_px != expected.bottom - expected.top
+        {
+            return Some(false);
+        }
+        if geometry.rolled {
+            let height = v.rolled_h_px();
+            expected.top = top_for_height(geometry.row_bottom, &expected, height);
+            expected.bottom = expected.top + height;
+            expected.right = expected.left + v.rolled_w_px();
+        }
+        Some(self.window.window_rect() == expected)
+    }
+}
+
+fn shown_note(v: &FenceViewState) -> Option<&str> {
+    v.note_edit
+        .as_ref()
+        .map(|edit| edit.text.as_str())
+        .or(v.note.as_deref())
+}
+
+fn mirror_items(items: &[ItemView]) -> Vec<ItemView> {
+    items
+        .iter()
+        .map(|item| ItemView {
+            label: None,
+            label_wide: false,
+            icon_failed: false,
+            icon_waited: false,
+            icon_fade: None,
+            fade_waits: None,
+            ..item.clone()
+        })
+        .collect()
+}
