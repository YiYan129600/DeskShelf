+        assert_eq!(map_axis((480, 960), (0, 1920), (-1280, 0), 64), Some((-960, -640)));
+        assert_eq!(map_axis((120, 300), (40, 1040), (120, 920), 54), Some((184, 328)));
+    }
+
+    #[test]
+    fn keeps_the_full_mirror_inside_its_work_area() {
+        assert_eq!(map_axis((900, 1300), (0, 1000), (0, 500), 64), Some((300, 500)));
+        assert_eq!(map_axis((-200, 1200), (0, 1000), (300, 320), 128), Some((300, 320)));
+        assert_eq!(map_axis((10, 15), (0, 1000), (0, 500), 128), Some((5, 133)));
+        assert_eq!(map_axis((10, 15), (0, 0), (0, 500), 128), None);
+    }
+
+    #[test]
+    fn maps_a_mirror_move_back_and_reprojects_it() {
+        let home = area(rect(0, 0, 1920, 1040), 96);
+        let target = area(rect(-1280, 100, 0, 900), 144);
+        let origin = rect(600, 130, 1080, 520);
+        let before = monitor_bounds(origin, &home, &target).unwrap();
+        assert_eq!(before, rect(-880, 200, -560, 500));
+
+        let moved = rect(-800, 260, -480, 560);
+        let saved = reverse_monitor_edit(moved, before, origin, &target, &home).unwrap();
+        assert_eq!(saved, rect(720, 208, 1200, 598));
+        assert_eq!(monitor_bounds(saved, &home, &target), Some(moved));
+    }
+
+    #[test]
+    fn maps_a_mirror_resize_about_its_fixed_edges() {
+        let home = area(rect(0, 0, 1920, 1040), 96);
+        let target = area(rect(-1280, 100, 0, 900), 144);
+        let origin = rect(600, 130, 1080, 520);
+        let before = monitor_bounds(origin, &home, &target).unwrap();
+        let resized = rect(-960, 200, -560, 600);
+        let saved = reverse_monitor_edit(resized, before, origin, &target, &home).unwrap();
+        assert_eq!(saved, rect(480, 130, 1080, 650));
+        assert_eq!(monitor_bounds(saved, &home, &target), Some(resized));
+    }
+
+    #[test]
+    fn preserves_size_when_moving_a_dpi_clamped_projection() {
+        assert_eq!(
+            reverse_axis_edit((200, 328), (100, 228), (200, 330), (0, 500), (0, 1000), 64),
+            Some((400, 530)),
+        );
+        assert_eq!(
+            reverse_axis_edit((460, 588), (100, 228), (200, 330), (0, 500), (0, 1000), 64),
+            Some((870, 1000)),
+        );
+        let at_edge = reverse_axis_edit((372, 500), (100, 228), (200, 330), (0, 500), (0, 1000), 64);
+        assert_eq!(at_edge, Some((870, 1000)));
+        assert_eq!(map_axis(at_edge.unwrap(), (0, 1000), (0, 500), 128), Some((372, 500)));
+    }
+
+    #[test]
+    fn reconstructs_the_expanded_bounds_of_a_bottom_anchored_tab_rail() {
+        let collapsed = rect(-1100, 610, -1010, 670);
+        assert_eq!(expand_rolled_rect(collapsed, 320, 300, true), rect(-1100, 370, -780, 670));
+        assert_eq!(expand_rolled_rect(collapsed, 320, 300, false), rect(-1100, 610, -780, 910));
+    }
+}
