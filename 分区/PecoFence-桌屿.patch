new file mode 100644
--- /dev/null
+++ b/crates/app/src/wallpaper_mode.rs
@@ -0,0 +1,29 @@
+use std::os::windows::process::CommandExt;
+use std::process::{ChildStdin, Command, Stdio};
+
+fn guardian() -> Option<Command> {
+    if std::env::var_os("PECOFENCE_INSTANCE").is_some()
+        || std::env::args_os().any(|s| s == "--no-hide-icons") {
+        return None;
+    }
+    let app = std::env::current_exe().ok()?;
+    let path = app.parent()?.join("桌屿壁纸助手.exe");
+    let mut cmd = Command::new(path);
+    cmd.creation_flags(0x08000000).stdout(Stdio::null()).stderr(Stdio::null());
+    Some(cmd)
+}
+
+pub(crate) fn recover() {
+    if let Some(mut cmd) = guardian() {
+        let _ = cmd.arg("--recover").stdin(Stdio::null()).spawn();
+    }
+}
+
+/// Dropping the pipe releases the taskbars, including on an abnormal parent exit.
+pub(crate) fn begin() -> Option<ChildStdin> {
+    let mut cmd = guardian()?;
+    match cmd.arg("--hold").stdin(Stdio::piped()).spawn() {
+        Ok(mut child) => child.stdin.take(),
+        Err(e) => { tracing::warn!(error = %e, "wallpaper taskbar helper unavailable"); None }
+    }
+}
