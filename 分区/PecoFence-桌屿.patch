 use super::*;
 use crate::layout::{FIT_SLACK_PX, clearance};
+
+/// Place large fences first, in columns from the right edge. An entire monitor's
+/// placement is planned before any of its windows move.
+fn packed_spot(work: RECT, occupied: &[RECT], width: i32, height: i32, gap: i32) -> Option<RECT> {
+    let mut xs = vec![(work.right - gap - width).max(work.left)];
+    let mut ys = vec![(work.top + gap).min(work.bottom - height).max(work.top)];
+    for r in occupied {
+        xs.push(r.left - gap - width);
+        ys.push(r.bottom + gap);
+    }
+    xs.sort_unstable_by(|a, b| b.cmp(a));
+    xs.dedup();
+    ys.sort_unstable();
+    ys.dedup();
+    for x in xs {
+        if x < work.left || x + width > work.right { continue; }
+        for &y in &ys {
+            if y < work.top || y + height > work.bottom { continue; }
+            let r = RECT { left: x, top: y, right: x + width, bottom: y + height };
+            if occupied.iter().all(|o| r.right + gap <= o.left || o.right + gap <= r.left ||
+                r.bottom + gap <= o.top || o.bottom + gap <= r.top) { return Some(r); }
+        }
+    }
+    None
+}
 
