+impl WindowsColors {
+    pub fn changed_since(self, previous: Self) -> bool {
+        fn changed<T: PartialEq>(current: Option<T>, previous: Option<T>) -> bool {
+            current.zip(previous).is_some_and(|(a, b)| a != b)
+        }
+        changed(self.accent, previous.accent)
+            || changed(self.apps_light, previous.apps_light)
+            || changed(self.system_light, previous.system_light)
+    }
+
+    pub fn with_previous(self, previous: Self) -> Self {
+        Self {
+            accent: self.accent.or(previous.accent),
+            apps_light: self.apps_light.or(previous.apps_light),
+            system_light: self.system_light.or(previous.system_light),
+        }
+    }
 }
 
