 impl App {
+    /// Reposition free, visible-on-this-desktop hosts within their own monitor.
+    /// Reserve each folded window's expanded footprint, including upward expansion.
+    pub(super) fn arrange_desktop_fences(&mut self, dry_run: bool) -> (usize, usize, Option<uuid::Uuid>) {
+        let mut moves = Vec::new();
+        let mut crowded = 0;
+        for area in &self.state.work_areas {
+            let work = RECT { left: area.left, top: area.top, right: area.right, bottom: area.bottom };
+            let mut obstacles = Vec::new();
+            let mut movable = Vec::new();
+            let gap = (10.0 * area.scale()).round().max(1.0) as i32;
+            for f in self.state.host_fences() {
+                let Some(w) = self.fences.get(&f.id) else { continue };
+                if w.is_desktop_arranged() || !self.on_current_desktop(f.id) { continue; }
+                let rest = self.ctx.behavior.resting_rect(w.hwnd(), w.resting_rect());
+                let (x, y) = ((rest.left + rest.right) / 2, (rest.top + rest.bottom) / 2);
+                if !self.work_area_at(x, y).is_some_and(|wa| wa.device_path == area.device_path) { continue; }
+                let (right, below) = w.open_hang_px();
+                let mut room = RECT { right: rest.right + right, bottom: rest.bottom + below, ..rest };
+                if w.is_rolled() && (f.expand_upward || w.row_at_bottom()) {
+                    room.top = room.bottom - (room.bottom - room.top).max(w.expanded_height_px());
+                }
+                if f.locked { obstacles.push(room); } else { movable.push((f.id, rest, room)); }
+            }
+            movable.sort_by_key(|(id, _, room)| (
+                std::cmp::Reverse(room.right - room.left),
+                std::cmp::Reverse(room.bottom - room.top), *id));
+            let mut on_screen = Vec::new();
+            let mut fits = true;
+            for (id, rest, room) in movable {
+                let Some(spot) = packed_spot(work, &obstacles, room.right - room.left, room.bottom - room.top, gap) else {
+                    fits = false;
+                    break;
+                };
+                obstacles.push(spot);
+                let (dx, dy) = (spot.left - room.left, spot.top - room.top);
+                if dx != 0 || dy != 0 {
+                    on_screen.push((id, rest, RECT { left: rest.left + dx, right: rest.right + dx,
+                        top: rest.top + dy, bottom: rest.bottom + dy }));
+                }
+            }
+            if fits { moves.extend(on_screen); } else { crowded += 1; }
+        }
+        let count = moves.len();
+        if dry_run { return (count, crowded, None); }
+        let snapshot = if count == 0 { None } else { self.auto_snapshot() };
+        for (id, from, to) in moves { self.relocate(id, from, to, false); }
+        if count > 0 { self.push_settings_state(); }
+        (count, crowded, snapshot)
+    }
+
