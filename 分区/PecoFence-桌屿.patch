+//! Runtime-only copies of canonical fences on the other physical displays.
+
+use super::*;
+use pecofence_core::geometry::{MIN_H_DIP, MIN_W_DIP, PxRect, resolve_work_area};
+use serde_json::{Value, json};
+
+const SYNC_INTERVAL: Duration = Duration::from_millis(150);
+const CREATE_RETRY: Duration = Duration::from_secs(2);
+
+#[derive(Default)]
+pub(super) struct MonitorMirrors {
+    windows: HashMap<(FenceId, String), Mirror>,
+    last_sync: Option<Instant>,
+    retry_at: Option<Instant>,
+    exiting: bool,
+}
+
+struct Mirror {
+    window: FenceWindow,
+    source_hwnd: HWND,
+    target: WorkArea,
+    bounds: RECT,
+    off_desktop: bool,
+    held: bool,
+}
+
+struct DesiredMirror<'a> {
+    source: &'a FenceWindow,
+    target: &'a WorkArea,
+    bounds: RECT,
+    off_desktop: bool,
+    held: bool,
+    source_visible: bool,
+    exclude_quick_hide: bool,
+}
+
+impl App {
+    pub(super) fn sync_monitor_mirrors(&mut self) {
+        let mirrors = &mut self.monitor_mirrors;
+        if mirrors.exiting || window::session_ending() {
+            return;
+        }
+        let areas = &self.state.work_areas;
+        if !self.state.config.settings.mirror_fences_across_monitors || areas.len() < 2 {
+            mirrors.windows.clear();
+            mirrors.last_sync = None;
+            mirrors.retry_at = None;
+            return;
+        }
+        let now = Instant::now();
+        if mirrors
+            .last_sync
+            .is_some_and(|last| now - last < SYNC_INTERVAL)
+        {
+            return;
+        }
+        mirrors.last_sync = Some(now);
+        let can_create = mirrors.retry_at.is_none_or(|retry| now >= retry);
+
+        let mut desired = HashMap::new();
+        let mut moving_sources = HashSet::new();
+        for (id, source) in &self.fences {
+            let Some(fence) = self.state.fence(*id) else {
+                continue;
+            };
+            if !desktop::is_window(source.hwnd()) {
+                continue;
+            }
+            if source.mirror_geometry_busy() {
+                moving_sources.insert(*id);
+                continue;
+            }
+            let rest = source.resting_rect();
+            let Some(home) = source_monitor(rest, areas)
+                .or_else(|| resolve_work_area(&fence.geometry, areas))
+            else {
+                continue;
+            };
+            let bounds = if source.is_rolled() && !source.rests_rolled() {
+                // Hover can temporarily change the side the title opens from. Keep the
+                // projection at the actual fence's saved expanded position during the peek.
+                win_rect(self.state.fence_px_rect(fence))
+            } else {
+                expanded_rect(source, rest)
+            };
+            let off_desktop = !self.state.on_current_desktop(*id);
+            let quick_hidden = self
+                .anchor
+                .borrow()
+                .as_ref()
+                .is_some_and(|a| a.quick_hides(source.hwnd(), self.windows_desktop));
+            let held = self.windows_desktop || (quick_hidden && self.peek.is_none());
+            let source_visible = desktop::is_visible(source.hwnd());
+            for target in areas.iter().filter(|a| monitor_key(a) != monitor_key(home)) {
+                if let Some(bounds) = monitor_bounds(bounds, home, target) {
+                    desired.insert(
+                        (*id, monitor_key(target).to_owned()),
+                        DesiredMirror {
+                            source,
+                            target,
+                            bounds,
+                            off_desktop,
+                            held,
+                            source_visible,
+                            exclude_quick_hide: fence.exclude_from_quick_hide,
+                        },
+                    );
+                }
+            }
+        }
+
+        // Remove vanished, displaced and invalid windows before creating any replacements.
+        mirrors.windows.retain(|key, mirror| {
+            if !desktop::is_window(mirror.window.hwnd()) {
+                return false;
+            }
+            if moving_sources.contains(&key.0) || mirror.window.mirror_geometry_busy() {
+                return self
+                    .fences
+                    .get(&key.0)
+                    .is_some_and(|w| w.hwnd() == mirror.source_hwnd)
+                    && areas.iter().any(|area| {
+                        monitor_key(area) == key.1.as_str()
+                            && area.device_path == mirror.target.device_path
+                    });
+            }
+            desired.get(key).is_some_and(|want| {
+                mirror.source_hwnd == want.source.hwnd()
+                    && mirror.target.device_path == want.target.device_path
+                    && mirror.target.dpi == want.target.dpi
+            })
+        });
+
+        let mut reanchor = false;
+        for (key, want) in desired {
+            let DesiredMirror {
+                source,
+                target,
+                bounds,
+                off_desktop,
+                held,
+                source_visible,
+                exclude_quick_hide,
+            } = want;
+            let mirror = match mirrors.windows.entry(key) {
+                std::collections::hash_map::Entry::Occupied(entry) => entry.into_mut(),
+                std::collections::hash_map::Entry::Vacant(entry) if can_create => {
+                    match FenceWindow::create_mirror(&self.ctx, source, bounds) {
+                        Ok(window) => {
+                            reanchor = true;
+                            entry.insert(Mirror {
+                                window,
+                                source_hwnd: source.hwnd(),
+                                target: target.clone(),
+                                bounds,
+                                off_desktop: false,
+                                held: false,
+                            })
+                        }
+                        Err(error) => {
+                            mirrors.retry_at = Some(now + CREATE_RETRY);
+                            tracing::warn!(fence = %source.id, monitor = %target.device_path, %error, "monitor mirror window failed");
+                            continue;
+                        }
+                    }
+                }
+                std::collections::hash_map::Entry::Vacant(_) => continue,
+            };
+
+            let w = &mirror.window;
+            if let Some(anchor) = self.anchor.borrow_mut().as_mut() {
+                anchor.set_quick_hide_excluded(w.hwnd(), exclude_quick_hide);
+            }
+            let desktop_changed = mirror.off_desktop != off_desktop;
+            if desktop_changed {
+                w.set_off_desktop(off_desktop);
+                mirror.off_desktop = off_desktop;
+            }
+            if !w.mirror_geometry_busy() {
+                w.sync_mirror_from(source);
+                w.sync_mirror_bounds(bounds);
+                mirror.bounds = bounds;
+                if mirror.target != *target {
+                    mirror.target = target.clone();
+                }
+            }
+            let visible = desktop::is_visible(w.hwnd());
+            if held && !mirror.held && !off_desktop && visible {
+                window::send_message(w.hwnd(), crate::commands::WM_APP_SET_VISIBLE, 0, 0);
+            } else if !off_desktop
+                && !held
+                && source_visible
+                && (!visible || desktop_changed || mirror.held)
+            {
+                w.show(false);
+                reanchor = true;
+            }
+            mirror.held = held;
+        }
+        if reanchor && let Some(anchor) = self.anchor.borrow_mut().as_mut() {
+            anchor.reanchor("monitor mirrors shown");
+        }
+    }
+
+    pub(super) fn mirror_windows_iter(&self) -> impl Iterator<Item = &FenceWindow> {
+        self.monitor_mirrors.windows.values().map(|mirror| &mirror.window)
+    }
+
+    pub(super) fn retire_monitor_mirrors(&mut self) -> bool {
+        self.monitor_mirrors.exiting = true;
+        self.mirror_windows_iter().fold(false, |any, w| w.retire() | any)
+    }
+
+    pub(super) fn on_mirror_bounds_edited(
+        &mut self,
+        id: FenceId,
+        hwnd: HWND,
+        rect: RECT,
+        rolled: bool,
+        expanded_height: i32,
+        expanded_width: i32,
+    ) {
+        let Some(mirror) = self.monitor_mirrors.windows.iter().find_map(|((fence, _), mirror)| {
+            (*fence == id && mirror.window.hwnd() == hwnd).then_some(mirror)
+        }) else {
+            return;
+        };
+        mirror.window.finish_mirror_geometry_edit();
+        if !self.state.config.settings.mirror_fences_across_monitors
+            || self.monitor_mirrors.exiting
+        {
+            return;
+        }
+        let (Some(source), Some(fence)) = (self.fences.get(&id), self.state.fence(id)) else {
+            return;
+        };
+        if source.hwnd() != mirror.source_hwnd
+            || source.mirror_geometry_busy()
+            || source.is_desktop_arranged()
+            || fence.locked
+        {
+            return;
+        }
+        let areas = &self.state.work_areas;
+        let rest = source.resting_rect();
+        let Some(home) = source_monitor(rest, areas)
+            .or_else(|| resolve_work_area(&fence.geometry, areas))
+        else {
+            return;
+        };
+        // A display change can invalidate a geometry edit queued before the new work area.
+        if monitor_key(home) == monitor_key(&mirror.target) || !areas.contains(&mirror.target) {
+            return;
+        }
+        let row_bottom = mirror.window.row_at_bottom();
+        let edited = if rolled {
+            expand_rolled_rect(rect, expanded_width, expanded_height, row_bottom)
+        } else {
+            rect
+        };
+        let before = win_rect(self.state.fence_px_rect(fence));
+        let source_before = if source.is_rolled() && !source.rests_rolled() {
+            before
+        } else {
+            expanded_rect(source, rest)
+        };
+        let Some(bounds) = reverse_monitor_edit(
+            edited,
+            mirror.bounds,
+            source_before,
+            &mirror.target,
+            home,
+        ) else {
+            return;
+        };
+
+        self.ctx.behavior.release_push(source.hwnd());
+        let height = bounds.bottom - bounds.top;
+        // For a rolled fence the state reads only the chosen title edge. The mapped
+        // expanded rect has the same edge and preserves the side through a restart.
+        self.state.set_fence_bounds(id, bounds, rolled, height, row_bottom, false);
+        let Some(saved) = self.state.fence(id) else {
+            return;
+        };
+        let applied = win_rect(self.state.fence_px_rect(saved));
+        source.set_row_at_bottom(row_bottom);
+        source.restore_geometry(applied, rolled, self.state.fence_expanded_px(saved));
+        if applied != before {
+            self.note_bounds_for_undo(id, before);
+        }
+        self.apply_auto_height(id);
+        self.arrange_desktop_fence();
+        self.schedule_save();
+        self.monitor_mirrors.last_sync = None;
+        self.sync_monitor_mirrors();
+    }
+
+    pub(super) fn monitor_mirrors_info(&self, id: FenceId) -> Value {
+        let host = self.state.host_of(id);
+        let source = self.fences.get(&host);
+        let mut windows: Vec<_> = self
+            .monitor_mirrors
+            .windows
+            .iter()
+            .filter(|((fence, _), mirror)| *fence == host && desktop::is_window(mirror.window.hwnd()))
+            .collect();
+        windows.sort_unstable_by(|(_, a), (_, b)| a.target.device_path.cmp(&b.target.device_path));
+        let mirrors: Vec<_> = windows
+            .into_iter()
+            .map(|(_, mirror)| {
+                let hwnd = mirror.window.hwnd();
+                let r = window::window_rect(hwnd);
+                json!({
+                    "monitor": mirror.target.device_path,
+                    "gdiName": mirror.target.gdi_name,
+                    "hwnd": hwnd.0 as usize,
+                    "windowRect": { "x": r.left, "y": r.top, "w": r.right - r.left, "h": r.bottom - r.top },
+                    "dpi": monitors::dpi_for_window(hwnd),
+                    "visible": desktop::is_visible(hwnd) && !desktop::is_cloaked(hwnd),
+                    "activeFence": mirror.window.active_fence(),
+                    "itemCount": mirror.window.item_count(),
+                    "itemIds": mirror.window.item_ids(),
+                    "scriptRowCount": mirror.window.script_row_count(),
+                    "contentMatchesSource": source.is_some_and(|w| mirror.window.displays_same_files_as(w)),
+                })
+            })
+            .collect();
+        json!({
+            "enabled": self.state.config.settings.mirror_fences_across_monitors,
+            "count": mirrors.len(),
+            "mirrors": mirrors,
+        })
+    }
+}
+
+fn monitor_key(area: &WorkArea) -> &str {
+    if area.gdi_name.is_empty() {
+        &area.device_path
+    } else {
+        &area.gdi_name
+    }
+}
+
+fn source_monitor(bounds: RECT, areas: &[WorkArea]) -> Option<&WorkArea> {
+    areas
+        .iter()
+        .filter_map(|area| {
+            let width = bounds.right.min(area.mon_right) - bounds.left.max(area.mon_left);
+            let height = bounds.bottom.min(area.mon_bottom) - bounds.top.max(area.mon_top);
+            (width > 0 && height > 0).then_some((i64::from(width) * i64::from(height), area))
+        })
+        .max_by_key(|(overlap, _)| *overlap)
+        .map(|(_, area)| area)
+}
+
+fn expanded_rect(source: &FenceWindow, mut rect: RECT) -> RECT {
+    if source.is_rolled() {
+        let width = source.collapsed_expanded_width_px().unwrap_or(rect.right - rect.left);
+        rect = expand_rolled_rect(rect, width, source.expanded_height_px(), source.row_at_bottom());
+    }
+    rect
+}
+
+fn expand_rolled_rect(mut rect: RECT, width: i32, height: i32, row_bottom: bool) -> RECT {
+    let height = height.max(rect.bottom - rect.top);
+    rect.right = rect.left + width.max(1);
+    if row_bottom {
+        rect.top = rect.bottom - height;
+    } else {
+        rect.bottom = rect.top + height;
+    }
+    rect
+}
+
+fn win_rect(px: PxRect) -> RECT {
+    RECT { left: px.left, top: px.top, right: px.right, bottom: px.bottom }
+}
+
+fn reverse_monitor_edit(
+    edited: RECT,
+    mirror_before: RECT,
+    source_before: RECT,
+    target: &WorkArea,
+    home: &WorkArea,
+) -> Option<RECT> {
+    let (left, right) = reverse_axis_edit(
+        (edited.left, edited.right),
+        (mirror_before.left, mirror_before.right),
+        (source_before.left, source_before.right),
+        (target.left, target.right),
+        (home.left, home.right),
+        (MIN_W_DIP * home.scale()).round() as i32,
+    )?;
+    let (top, bottom) = reverse_axis_edit(
+        (edited.top, edited.bottom),
+        (mirror_before.top, mirror_before.bottom),
+        (source_before.top, source_before.bottom),
+        (target.top, target.bottom),
+        (home.top, home.bottom),
+        (MIN_H_DIP * home.scale()).round() as i32,
+    )?;
+    Some(RECT { left, top, right, bottom })
+}
+
+fn reverse_axis_edit(
+    edited: (i32, i32),
+    mirror_before: (i32, i32),
+    source_before: (i32, i32),
+    mirror_work: (i32, i32),
+    source_work: (i32, i32),
+    minimum: i32,
+) -> Option<(i32, i32)> {
+    let mapped = map_axis(edited, mirror_work, source_work, minimum)?;
+    let work_size = source_work.1 - source_work.0;
+    // Preserve axes and fixed resize edges through projection rounding. A drag on a
+    // smaller mirror also preserves the source size when the mirror hit its DPI minimum.
+    let size = if edited.1 - edited.0 == mirror_before.1 - mirror_before.0 {
+        (source_before.1 - source_before.0).clamp(minimum.clamp(1, work_size), work_size)
+    } else {
+        mapped.1 - mapped.0
+    };
+    let start = if edited == mirror_before {
+        source_before.0
+    } else if edited.0 <= mirror_work.0 {
+        source_work.0
+    } else if edited.1 >= mirror_work.1 {
+        // A DPI minimum can make the mirror wider than its proportional projection.
+        // Its trailing edge still represents the end of the source work area.
+        source_work.1 - size
+    } else if edited.0 == mirror_before.0 {
+        source_before.0
+    } else if edited.1 == mirror_before.1 {
+        source_before.1 - size
+    } else {
+        source_work.0 + scale_axis_px(edited.0 - mirror_work.0, mirror_work.1 - mirror_work.0, work_size)
+    }
+    .clamp(source_work.0, source_work.1 - size);
+    Some((start, start + size))
+}
+
+fn monitor_bounds(bounds: RECT, home: &WorkArea, target: &WorkArea) -> Option<RECT> {
+    let (left, right) = map_axis(
+        (bounds.left, bounds.right),
+        (home.left, home.right),
+        (target.left, target.right),
+        (MIN_W_DIP * target.scale()).round() as i32,
+    )?;
+    let (top, bottom) = map_axis(
+        (bounds.top, bounds.bottom),
+        (home.top, home.bottom),
+        (target.top, target.bottom),
+        (MIN_H_DIP * target.scale()).round() as i32,
+    )?;
+    Some(RECT { left, top, right, bottom })
+}
+
+fn map_axis(
+    (start, end): (i32, i32),
+    (home_start, home_end): (i32, i32),
+    (target_start, target_end): (i32, i32),
+    minimum: i32,
+) -> Option<(i32, i32)> {
+    let home_size = home_end - home_start;
+    let target_size = target_end - target_start;
+    if end <= start || home_size <= 0 || target_size <= 0 {
+        return None;
+    }
+    let scale = |px| scale_axis_px(px, home_size, target_size);
+    let size = scale(end - start).clamp(minimum.clamp(1, target_size), target_size);
+    let offset = scale(start - home_start).clamp(0, target_size - size);
+    Some((target_start + offset, target_start + offset + size))
+}
+
+fn scale_axis_px(px: i32, from: i32, to: i32) -> i32 {
+    (f64::from(px) * f64::from(to) / f64::from(from)).round() as i32
+}
