+
+    #[test]
+    fn packed_fences_keep_locked_areas_and_monitor_bounds() {
+        let work = RECT { left: -960, top: 0, right: 0, bottom: 600 };
+        let locked = RECT { left: -310, top: 10, right: -10, bottom: 240 };
+        let next = packed_spot(work, &[locked], 300, 200, 10).unwrap();
+        assert_eq!((next.left, next.top), (-310, 250));
+        assert!(packed_spot(work, &[locked], 955, 400, 10).is_none());
+        let full = packed_spot(work, &[], 960, 600, 10).unwrap();
+        assert_eq!((full.left, full.top, full.right, full.bottom), (-960, 0, 0, 600));
+    }
+}
