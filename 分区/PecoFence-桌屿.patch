+/// A stationary pointer can end up over a fence when a window moves or closes. Check the
+/// visible HWND under it, including its real shape, and keep an active gesture or popup open.
+pub(super) fn on_timer_reveal_on_hover(h: &HandlerCtx, hwnd: HWND) -> Option<isize> {
+    let Ok(guard) = h.view.try_borrow() else {
+        return Some(0);
+    };
+    let Some(v) = guard.as_ref() else {
+        return Some(0);
+    };
+    if !v.reveal_on_hover
+        || v.retired
+        || v.off_desktop
+        || matches!(v.vis_fade, Some(VisFade::Hiding { .. }))
+        || !desktop::is_visible(hwnd)
+    {
+        return Some(0);
+    }
+
+    let pt = window::cursor_pos();
+    let rect = window::window_rect(hwnd);
+    let in_bounds = pt.x >= rect.left && pt.x < rect.right && pt.y >= rect.top && pt.y < rect.bottom;
+    let moving_with_group = h
+        .behavior
+        .size_move
+        .try_borrow()
+        .ok()
+        .is_some_and(|m| m.as_ref().is_some_and(|m| m.group.contains(&hwnd)));
+    let interacting = h.menu_open.get()
+        || h.in_size_move.get()
+        || moving_with_group
+        || window::get_capture() == hwnd
+        || (h.ncrbutton_press.get() && window::secondary_button_down_async())
+        || v.ole_drag
+        || v.remote_drag.is_some()
+        || v.drop_hover
+        || v.merge_hint
+        || v.renaming.is_some()
+        || v.title_renaming
+        || v.note_edit.is_some()
+        || crate::filter_box::active_fence() == Some(v.active)
+        || (v.peeking && h.behavior.holds_open(hwnd, pt));
+    drop(guard);
+
+    let Ok(anchor) = h.anchor.try_borrow() else {
+        return Some(0);
+    };
+    let quick_hidden = anchor.as_ref().is_some_and(|a| a.quick_hides(hwnd, false));
+    drop(anchor);
+    // WindowFromPoint can re-enter WM_NCHITTEST, so the view borrow has ended.
+    let show = !quick_hidden
+        && (interacting
+            || (in_bounds && desktop::root_ancestor(desktop::window_from_point(pt.x, pt.y)) == hwnd));
+    if let Ok(mut guard) = h.view.try_borrow_mut()
+        && let Some(v) = guard.as_mut()
+        && v.reveal_on_hover
+    {
+        v.set_hover_concealed(!show);
+    }
+    Some(0)
+}
